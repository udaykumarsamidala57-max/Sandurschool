<%@ page import="java.sql.*, java.util.*, com.bean.DBUtil" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>

<%
    if (request.getAttribute("events") == null) {
        List<Map<String, Object>> eventList = new ArrayList<>();
        String sql = "SELECT id, event_date, event_name, time_from, time_to, place, event_description, image_blob " +
                     "FROM upcoming_events WHERE event_date >= CURDATE() ORDER BY event_date ASC";

        try (Connection conn = DBUtil.getConnection("SRS");
             PreparedStatement stmt = conn.prepareStatement(sql);
             ResultSet rs = stmt.executeQuery()) {

            while (rs.next()) {
                Map<String, Object> event = new HashMap<>();
                event.put("id", rs.getInt("id"));
                event.put("eventDate", rs.getString("event_date"));
                event.put("eventName", rs.getString("event_name"));
                event.put("timeFrom", rs.getString("time_from"));
                event.put("timeTo", rs.getString("time_to"));
                event.put("place", rs.getString("place"));
                event.put("eventDescription", rs.getString("event_description"));

                byte[] imgBytes = rs.getBytes("image_blob");
                if (imgBytes != null && imgBytes.length > 0) {
                    event.put("imageBase64", Base64.getEncoder().encodeToString(imgBytes));
                } else {
                    event.put("imageBase64", null);
                }

                eventList.add(event);
            }
        } catch (Exception e) {
            e.printStackTrace();
        }

        request.setAttribute("events", eventList);
    }
%>

<div class="campus-events-section">
    <div class="section-header">
        <h2 class="section-title">Campus Events</h2>
        <p class="section-subtitle">Discover upcoming academic seminars, cultural festivals, and campus gatherings.</p>
    </div>

    <div class="events-grid">
        <c:choose>
            <c:when test="${not empty events}">
                <c:forEach var="event" items="${events}">
                    <div class="event-card" onclick="openEventModal(this)"
                         data-title="${event.eventName}"
                         data-date="${event.eventDate}"
                         data-time="${event.timeFrom} - ${event.timeTo}"
                         data-place="${event.place}"
                         data-description="${event.eventDescription}"
                         data-image="${not empty event.imageBase64 ? 'data:image/jpeg;base64,'.concat(event.imageBase64) : ''}">
                        
                        <div class="card-info-box">
                            <div class="event-badge">${event.eventDate}</div>
                            <h3 class="event-title">${event.eventName}</h3>
                            
                            <div class="event-meta">
                                <div class="meta-item">
                                    <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    <span>${event.eventDate}</span>
                                </div>
                                <div class="meta-item">
                                    <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                    <span>${event.timeFrom} - ${event.timeTo}</span>
                                </div>
                                <div class="meta-item">
                                    <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                    <span>${event.place}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </c:forEach>
            </c:when>
            <c:otherwise>
                <div class="no-events">
                    <p>No upcoming events scheduled right now.</p>
                </div>
            </c:otherwise>
        </c:choose>
    </div>
</div>

<!-- Event Details Modal Pop-Up -->
<div id="eventModal" class="event-modal">
    <div class="modal-content">
        <button class="close-btn" onclick="closeEventModal()" aria-label="Close">&times;</button>
        
        <div id="modalImageContainer" class="modal-image-container">
            <img id="modalImage" src="" alt="Event Cover">
        </div>
        
        <div class="modal-body">
            <h2 id="modalTitle"></h2>
            
            <div class="modal-meta">
                <div class="modal-meta-item">
                    <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    <strong id="modalDate"></strong>
                </div>
                <div class="modal-meta-item">
                    <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    <strong id="modalTime"></strong>
                </div>
                <div class="modal-meta-item">
                    <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    <strong id="modalPlace"></strong>
                </div>
            </div>
            
            <p id="modalDescription" class="modal-description"></p>
        </div>
    </div>
</div>

<script>
    function openEventModal(cardElement) {
        document.getElementById('modalTitle').innerText = cardElement.getAttribute('data-title');
        document.getElementById('modalDate').innerText = cardElement.getAttribute('data-date');
        document.getElementById('modalTime').innerText = cardElement.getAttribute('data-time');
        document.getElementById('modalPlace').innerText = cardElement.getAttribute('data-place');
        document.getElementById('modalDescription').innerText = cardElement.getAttribute('data-description');

        var imgSrc = cardElement.getAttribute('data-image');
        var imgElement = document.getElementById('modalImage');
        var imgContainer = document.getElementById('modalImageContainer');

        if (imgSrc) {
            imgElement.src = imgSrc;
            imgContainer.style.display = 'block';
        } else {
            imgContainer.style.display = 'none';
        }

        document.getElementById('eventModal').classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeEventModal() {
        document.getElementById('eventModal').classList.remove('active');
        document.body.style.overflow = 'auto';
    }

    window.onclick = function(event) {
        var modal = document.getElementById('eventModal');
        if (event.target === modal) {
            closeEventModal();
        }
    };
</script>