<%@ page import="java.sql.*, java.util.*, java.text.SimpleDateFormat, com.bean.DBUtil" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>

<%
    if (request.getAttribute("events") == null) {
        List<Map<String, Object>> eventList = new ArrayList<>();
        String sql = "SELECT id, event_date, event_name, time_from, time_to, place, event_description, image_blob " +
                     "FROM upcoming_events WHERE event_date >= CURDATE() ORDER BY event_date ASC";

        SimpleDateFormat dbDateFormat = new SimpleDateFormat("yyyy-MM-dd");
        SimpleDateFormat displayDateFormat = new SimpleDateFormat("dd MMMM yyyy");
        SimpleDateFormat inputTimeFormat = new SimpleDateFormat("HH:mm:ss");
        SimpleDateFormat displayTimeFormat = new SimpleDateFormat("hh:mm a");

        try (Connection conn = DBUtil.getConnection("SRS");
             PreparedStatement stmt = conn.prepareStatement(sql);
             ResultSet rs = stmt.executeQuery()) {

            while (rs.next()) {
                Map<String, Object> event = new HashMap<>();
                event.put("id", rs.getInt("id"));
                
                // Format Date into Uppercase Display Format (e.g., 26 JANUARY 2026)
                String rawDate = rs.getString("event_date");
                if (rawDate != null) {
                    try {
                        java.util.Date parsedDate = dbDateFormat.parse(rawDate);
                        event.put("eventDate", displayDateFormat.format(parsedDate).toUpperCase());
                    } catch (Exception e) {
                        event.put("eventDate", rawDate);
                    }
                } else {
                    event.put("eventDate", "");
                }

                // Format Time Range (e.g., 10:00 AM - 01:00 PM)
                String rawTimeFrom = rs.getString("time_from");
                String rawTimeTo = rs.getString("time_to");
                String timeFormatted = "";

                try {
                    if (rawTimeFrom != null) {
                        timeFormatted += displayTimeFormat.format(inputTimeFormat.parse(rawTimeFrom));
                    }
                    if (rawTimeTo != null) {
                        timeFormatted += " - " + displayTimeFormat.format(inputTimeFormat.parse(rawTimeTo));
                    }
                } catch (Exception e) {
                    timeFormatted = (rawTimeFrom != null ? rawTimeFrom : "") + 
                                    (rawTimeTo != null ? " - " + rawTimeTo : "");
                }
                event.put("timeRange", timeFormatted);

                event.put("eventName", rs.getString("event_name"));
                event.put("place", rs.getString("place"));
                event.put("eventDescription", rs.getString("event_description"));

                // Image Encoding
                byte[] imgBytes = rs.getBytes("image_blob");
                if (imgBytes != null && imgBytes.length > 0) {
                    event.put("imageBase64", Base64.getEncoder().encodeToString(imgBytes));
                } else {
                    event.put("imageBase64", null);
                }

                eventList.add(event);
            }
        } catch (Exception e) {
            e.printStackTrace();
        }

        request.setAttribute("events", eventList);
    }
%>

<div class="campus-events-section">
    <div class="section-header">
        <h2 class="section-title">Upcoming Campus Events</h2>
        <p class="section-subtitle">Official announcements, academic schedules, and institutional events.</p>
    </div>

    <div class="events-grid">
        <c:choose>
            <c:when test="${not empty events}">
                <c:forEach var="event" items="${events}">
                    <div class="event-card" onclick="openEventModal(this)"
                         data-title="${fn:escapeXml(event.eventName)}"
                         data-date="${fn:escapeXml(event.eventDate)}"
                         data-time="${fn:escapeXml(event.timeRange)}"
                         data-place="${fn:escapeXml(event.place)}"
                         data-description="${fn:escapeXml(event.eventDescription)}"
                         data-image="${not empty event.imageBase64 ? 'data:image/jpeg;base64,'.concat(event.imageBase64) : ''}">
                        
                        <div class="card-info-box">
                            <div class="event-badge">${event.eventDate}</div>
                            <h3 class="event-title">${event.eventName}</h3>
                            
                            <div class="event-meta">
                                <div class="meta-item">
                                    <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    <span>${event.eventDate}</span>
                                </div>
                                <div class="meta-item">
                                    <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                    <span>${event.timeRange}</span>
                                </div>
                                <div class="meta-item">
                                    <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                    <span>${event.place}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </c:forEach>
            </c:when>
            <c:otherwise>
                <div class="no-events">
                    <p>No upcoming events currently scheduled.</p>
                </div>
            </c:otherwise>
        </c:choose>
    </div>
</div>

<!-- Modal Dialog -->
<div id="eventModal" class="event-modal" role="dialog" aria-modal="true">
    <div class="modal-content">
        <button class="close-btn" onclick="closeEventModal()" aria-label="Close modal">&times;</button>
        
        <div id="modalImageContainer" class="modal-image-container" style="display: none;">
            <img id="modalImage" src="" alt="Event Banner">
        </div>
        
        <div class="modal-body">
            <h2 id="modalTitle"></h2>
            
            <div class="modal-meta">
                <div class="modal-meta-item">
                    <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    <span id="modalDate"></span>
                </div>
                <div class="modal-meta-item">
                    <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    <span id="modalTime"></span>
                </div>
                <div class="modal-meta-item">
                    <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    <span id="modalPlace"></span>
                </div>
            </div>
            
            <p id="modalDescription" class="modal-description"></p>
        </div>
    </div>
</div>

<script>
    function openEventModal(cardElement) {
        var title = cardElement.getAttribute('data-title') || '';
        var date = cardElement.getAttribute('data-date') || 'N/A';
        var time = cardElement.getAttribute('data-time') || 'N/A';
        var place = cardElement.getAttribute('data-place') || 'N/A';
        var description = cardElement.getAttribute('data-description') || 'No description provided for this event.';
        var imgSrc = cardElement.getAttribute('data-image');

        document.getElementById('modalTitle').textContent = title;
        document.getElementById('modalDate').textContent = date;
        document.getElementById('modalTime').textContent = time;
        document.getElementById('modalPlace').textContent = place;
        document.getElementById('modalDescription').textContent = description;

        var imgElement = document.getElementById('modalImage');
        var imgContainer = document.getElementById('modalImageContainer');

        if (imgSrc && imgSrc.trim() !== '') {
            imgElement.src = imgSrc;
            imgContainer.style.display = 'block';
        } else {
            imgElement.src = '';
            imgContainer.style.display = 'none';
        }

        var modal = document.getElementById('eventModal');
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeEventModal() {
        var modal = document.getElementById('eventModal');
        modal.classList.remove('active');
        document.body.style.overflow = 'auto';
    }

    window.addEventListener('click', function(event) {
        var modal = document.getElementById('eventModal');
        if (event.target === modal) {
            closeEventModal();
        }
    });

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeEventModal();
        }
    });
</script>