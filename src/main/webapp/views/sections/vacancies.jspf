<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="java.sql.*" %>
<%@ page import="com.bean.DBUtil2" %>

<%!
    // Helper to escape HTML and prevent XSS in dynamic outputs
    private String escapeHtml(String input) {
        if (input == null) return "";
        return input.replace("&", "&amp;")
                    .replace("<", "&lt;")
                    .replace(">", "&gt;")
                    .replace("\"", "&quot;")
                    .replace("'", "&#39;");
    }
%>

<%
    String filterType = request.getParameter("job_type");
    String searchQuery = request.getParameter("search");

    boolean hasFilter = (filterType != null && !filterType.trim().isEmpty() && !filterType.equalsIgnoreCase("All"));
    boolean hasSearch = (searchQuery != null && !searchQuery.trim().isEmpty());

    // Helper method to build category specific SQL queries dynamically
    StringBuilder sql = new StringBuilder("SELECT * FROM school_vacancies WHERE status = 'Open'");
    if (hasFilter) {
        sql.append(" AND job_type = ?");
    }
    if (hasSearch) {
        sql.append(" AND (job_title LIKE ? OR department LIKE ? OR subject LIKE ? OR location LIKE ?)");
    }
    sql.append(" ORDER BY display_order ASC, created_at DESC");
%>

<style>
    .srs-vacancies-wrapper {
        --primary-dark: #612405;
        --primary-accent: #e26a2c;
        --primary-light: #fdf5f0;
        --bg-color: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #2b1208;
        --text-muted: #6e5c54;
        --border-color: #e5d8cf;
        --shadow-sm: 0 2px 8px rgba(97, 36, 5, 0.06);
        --shadow-md: 0 6px 18px rgba(97, 36, 5, 0.12);
        --shadow-lg: 0 12px 28px rgba(97, 36, 5, 0.2);
        
        width: 100%;
        background-color: var(--bg-color);
        color: var(--text-main);
        padding: 1.5rem 1rem;
        line-height: 1.5;
        box-sizing: border-box;
    }

    .srs-vacancies-wrapper * {
        box-sizing: border-box;
    }

    .srs-vacancies-wrapper .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Embedded Header Block */
    .srs-vacancies-wrapper .header {
        text-align: center;
        margin-bottom: 1.75rem;
    }

    .srs-vacancies-wrapper .header h2 {
        color: var(--primary-dark);
        margin: 0 0 0.4rem 0;
        font-size: 1.85rem;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .srs-vacancies-wrapper .header p.tagline {
        color: var(--text-muted);
        margin: 0;
        font-size: 1rem;
    }

    /* Notice Banner */
    .srs-vacancies-wrapper .notice-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-left: 4px solid var(--primary-accent);
        border-radius: 8px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.75rem;
        box-shadow: var(--shadow-sm);
        font-size: 0.9rem;
    }

    .srs-vacancies-wrapper .notice-card p {
        margin: 0 0 0.5rem 0;
    }

    .srs-vacancies-wrapper .notice-card p:last-child {
        margin-bottom: 0;
    }

    /* Search & Filter Controls */
    .srs-vacancies-wrapper .search-bar {
        background: var(--card-bg);
        padding: 0.85rem;
        border-radius: 10px;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-color);
        margin-bottom: 2rem;
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .srs-vacancies-wrapper .search-input-group {
        position: relative;
        flex: 2;
        min-width: 240px;
    }

    .srs-vacancies-wrapper .search-bar input, 
    .srs-vacancies-wrapper .search-bar select {
        width: 100%;
        padding: 0.6rem 0.85rem;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        font-size: 0.9rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
        color: var(--text-main);
        background-color: #fff;
    }

    .srs-vacancies-wrapper .search-bar select {
        flex: 1;
        min-width: 160px;
        cursor: pointer;
    }

    .srs-vacancies-wrapper .search-bar input:focus, 
    .srs-vacancies-wrapper .search-bar select:focus {
        border-color: var(--primary-accent);
        box-shadow: 0 0 0 3px rgba(226, 106, 44, 0.15);
    }

    .srs-vacancies-wrapper .search-bar button {
        background-color: var(--primary-accent);
        color: white;
        border: none;
        padding: 0.6rem 1.35rem;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.9rem;
        transition: background-color 0.2s, transform 0.1s, box-shadow 0.2s;
        box-shadow: 0 2px 6px rgba(226, 106, 44, 0.25);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
    }

    .srs-vacancies-wrapper .search-bar button:hover {
        background-color: var(--primary-dark);
    }

    /* Section Headings for Categorization */
    .srs-vacancies-wrapper .category-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--primary-dark);
        margin: 2rem 0 1rem 0;
        padding-bottom: 0.4rem;
        border-bottom: 2px solid var(--primary-accent);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .srs-vacancies-wrapper .category-section:first-of-type .category-title {
        margin-top: 0;
    }

    /* Grid Layout */
    .srs-vacancies-wrapper .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
        gap: 1.25rem;
        margin-bottom: 1.5rem;
    }

    .srs-vacancies-wrapper .card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: var(--shadow-sm);
        transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }

    .srs-vacancies-wrapper .card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
        border-color: var(--primary-accent);
    }

    .srs-vacancies-wrapper .card-header-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .srs-vacancies-wrapper .badge {
        display: inline-block;
        padding: 0.2rem 0.55rem;
        font-size: 0.7rem;
        font-weight: 700;
        border-radius: 9999px;
        background-color: var(--primary-light);
        color: var(--primary-dark);
        border: 1px solid rgba(97, 36, 5, 0.15);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .srs-vacancies-wrapper .card-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--primary-dark);
        margin: 0 0 0.5rem 0;
        line-height: 1.35;
    }

    .srs-vacancies-wrapper .card-meta {
        color: var(--text-muted);
        font-size: 0.85rem;
        margin-bottom: 0.85rem;
        padding-bottom: 0.65rem;
        border-bottom: 1px dashed var(--border-color);
    }

    .srs-vacancies-wrapper .info-details {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin-bottom: 1rem;
    }

    .srs-vacancies-wrapper .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.85rem;
    }

    .srs-vacancies-wrapper .info-row strong {
        color: var(--text-muted);
        font-weight: 600;
    }

    .srs-vacancies-wrapper .card-actions {
        margin-top: auto;
        padding-top: 0.85rem;
        display: flex;
        gap: 0.5rem;
        border-top: 1px solid var(--border-color);
    }

    .srs-vacancies-wrapper .btn {
        flex: 1;
        padding: 0.5rem 0.75rem;
        border: 1px solid transparent;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        font-size: 0.85rem;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
    }

    .srs-vacancies-wrapper .btn-primary {
        background-color: var(--primary-accent);
        color: white;
        border-color: var(--primary-accent);
    }

    .srs-vacancies-wrapper .btn-primary:hover {
        background-color: var(--primary-dark);
        border-color: var(--primary-dark);
    }

    .srs-vacancies-wrapper .btn-secondary {
        background-color: #ffffff;
        color: var(--primary-dark);
        border-color: var(--border-color);
    }

    .srs-vacancies-wrapper .btn-secondary:hover {
        background-color: var(--primary-light);
        border-color: var(--primary-dark);
    }

    .srs-vacancies-wrapper .empty-state {
        text-align: center;
        background: var(--card-bg);
        border: 1px dashed var(--border-color);
        border-radius: 10px;
        padding: 2.5rem 1.5rem;
        color: var(--text-muted);
        margin-bottom: 1.5rem;
    }

    .srs-vacancies-wrapper .empty-state h3 {
        margin: 0 0 0.5rem 0;
        color: var(--primary-dark);
    }

    /* Modal Overlay */
    .srs-vacancies-wrapper .modal {
        display: none;
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(43, 18, 8, 0.6);
        backdrop-filter: blur(3px);
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 1rem;
    }

    .srs-vacancies-wrapper .modal-content {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        max-width: 600px;
        width: 100%;
        max-height: 85vh;
        overflow-y: auto;
        position: relative;
        box-shadow: var(--shadow-lg);
        border: 1px solid var(--border-color);
    }

    .srs-vacancies-wrapper .close-btn {
        position: absolute;
        top: 0.85rem;
        right: 0.85rem;
        font-size: 1.4rem;
        cursor: pointer;
        border: none;
        background: transparent;
        color: var(--text-muted);
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .srs-vacancies-wrapper .close-btn:hover {
        background-color: var(--primary-light);
        color: var(--primary-dark);
    }

    .srs-vacancies-wrapper .modal-section {
        margin-bottom: 0.85rem;
        padding-bottom: 0.65rem;
        border-bottom: 1px solid var(--border-color);
    }

    .srs-vacancies-wrapper .modal-section:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }

    .srs-vacancies-wrapper .modal-section h4 {
        margin: 0 0 0.25rem 0;
        color: var(--primary-accent);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
    }

    .srs-vacancies-wrapper .modal-section p {
        margin: 0;
        color: var(--text-main);
        font-size: 0.9rem;
        white-space: pre-line;
    }

    @media (max-width: 600px) {
        .srs-vacancies-wrapper .search-bar {
            flex-direction: column;
            align-items: stretch;
        }
        .srs-vacancies-wrapper .search-bar button {
            width: 100%;
        }
    }
</style>

<div class="srs-vacancies-wrapper">
    <div class="container">
        <div class="header">
            <h2>Current Openings</h2>
            <p class="tagline">Explore opportunities and build a meaningful career with SRS</p>
        </div>

        <div class="notice-card">
            <p>We seek to recruit dedicated professionals to support the SRS mission. Explore our open roles below to join our team!</p>
            <p><strong>Safeguarding Statement:</strong> SRS is committed to safeguarding children. Background screening may be conducted prior to or during employment.</p>
        </div>

        <form class="search-bar" method="GET" action="">
            <div class="search-input-group">
                <input type="text" name="search" placeholder="Search by title, department, subject, or location..." value="<%= searchQuery != null ? escapeHtml(searchQuery) : "" %>">
            </div>
            
            <select name="job_type">
                <option value="All">All Job Types</option>
                <option value="Teaching" <%= "Teaching".equals(filterType) ? "selected" : "" %>>Teaching</option>
                <option value="Non-Teaching" <%= "Non-Teaching".equals(filterType) ? "selected" : "" %>>Non-Teaching</option>
            </select>
            
            <button type="submit">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/></svg>
                Filter
            </button>
        </form>

        <%
            boolean anyVacanciesFound = false;

            try (Connection conn = DBUtil2.getConnection();
                 PreparedStatement pstmt = conn.prepareStatement(sql.toString())) {

                int paramIdx = 1;
                if (hasFilter) {
                    pstmt.setString(paramIdx++, filterType);
                }
                if (hasSearch) {
                    String pattern = "%" + searchQuery.trim() + "%";
                    pstmt.setString(paramIdx++, pattern);
                    pstmt.setString(paramIdx++, pattern);
                    pstmt.setString(paramIdx++, pattern);
                    pstmt.setString(paramIdx++, pattern);
                }

                // Temporary data structures to store records separately
                java.util.List<java.util.Map<String, Object>> teachingList = new java.util.ArrayList<>();
                java.util.List<java.util.Map<String, Object>> nonTeachingList = new java.util.ArrayList<>();

                try (ResultSet rs = pstmt.executeQuery()) {
                    while (rs.next()) {
                        anyVacanciesFound = true;
                        java.util.Map<String, Object> map = new java.util.HashMap<>();
                        map.put("id", rs.getInt("id"));
                        map.put("title", rs.getString("job_title"));
                        map.put("type", rs.getString("job_type"));
                        map.put("dept", rs.getString("department"));
                        map.put("subject", rs.getString("subject"));
                        map.put("empType", rs.getString("employment_type"));
                        map.put("location", rs.getString("location"));
                        map.put("salary", rs.getString("salary"));
                        map.put("vacancies", rs.getInt("number_of_vacancies"));
                        map.put("lastDate", rs.getDate("application_last_date"));
                        map.put("qual", rs.getString("qualification"));
                        map.put("exp", rs.getString("experience"));
                        map.put("desc", rs.getString("job_description"));
                        map.put("resp", rs.getString("responsibilities"));
                        map.put("skills", rs.getString("skills_required"));
                        map.put("email", rs.getString("application_email"));
                        map.put("link", rs.getString("application_link"));
                        map.put("contactPerson", rs.getString("contact_person"));
                        map.put("contactPhone", rs.getString("contact_phone"));

                        String typeStr = (String) map.get("type");
                        if ("Teaching".equalsIgnoreCase(typeStr)) {
                            teachingList.add(map);
                        } else {
                            nonTeachingList.add(map);
                        }
                    }
                }

                if (anyVacanciesFound) {
                    // Render Teaching Positions Section
                    if (!teachingList.isEmpty() && (!hasFilter || "Teaching".equalsIgnoreCase(filterType))) {
        %>
                        <div class="category-section">
                            <h3 class="category-title">Teaching Roles</h3>
                            <div class="grid">
                                <%
                                    for (java.util.Map<String, Object> row : teachingList) {
                                        int id = (Integer) row.get("id");
                                        String title = (String) row.get("title");
                                        String type = (String) row.get("type");
                                        String dept = (String) row.get("dept");
                                        String subject = (String) row.get("subject");
                                        String empType = (String) row.get("empType");
                                        String location = (String) row.get("location");
                                        String salary = (String) row.get("salary");
                                        int vacancies = (Integer) row.get("vacancies");
                                        java.sql.Date lastDate = (java.sql.Date) row.get("lastDate");
                                        String qual = (String) row.get("qual");
                                        String exp = (String) row.get("exp");
                                        String desc = (String) row.get("desc");
                                        String resp = (String) row.get("resp");
                                        String skills = (String) row.get("skills");
                                        String email = (String) row.get("email");
                                        String link = (String) row.get("link");
                                        String contactPerson = (String) row.get("contactPerson");
                                        String contactPhone = (String) row.get("contactPhone");

                                        String contactInfo = (contactPerson != null ? contactPerson : "HR Department") + 
                                                             (contactPhone != null && !contactPhone.trim().isEmpty() ? " (" + contactPhone + ")" : "");
                                %>
                                    <div class="card">
                                        <div>
                                            <div class="card-header-meta">
                                                <span class="badge"><%= escapeHtml(type) %></span>
                                            </div>
                                            <h3 class="card-title"><%= escapeHtml(title) %></h3>
                                            <div class="card-meta">
                                                <strong>Department:</strong> <%= (dept != null && !dept.trim().isEmpty()) ? escapeHtml(dept) : "General" %>
                                                <% if (subject != null && !subject.trim().isEmpty()) { %>
                                                    <br><strong>Subject:</strong> <%= escapeHtml(subject) %>
                                                <% } %>
                                            </div>

                                            <div class="info-details">
                                                <div class="info-row"><strong>Employment:</strong> <span><%= empType != null ? escapeHtml(empType) : "N/A" %></span></div>
                                                <div class="info-row"><strong>Location:</strong> <span><%= location != null ? escapeHtml(location) : "N/A" %></span></div>
                                                <div class="info-row"><strong>Vacancies:</strong> <span><%= vacancies %></span></div>
                                                <% if (salary != null && !salary.trim().isEmpty()) { %>
                                                    <div class="info-row"><strong>Salary:</strong> <span><%= escapeHtml(salary) %></span></div>
                                                <% } %>
                                                <% if (lastDate != null) { %>
                                                    <div class="info-row"><strong>Last Date:</strong> <span><%= lastDate.toString() %></span></div>
                                                <% } %>
                                            </div>
                                        </div>

                                        <div class="card-actions">
                                            <button type="button" class="btn btn-secondary"
                                                    data-title="<%= escapeHtml(title) %>"
                                                    data-type="<%= escapeHtml(type) %>"
                                                    data-dept="<%= dept != null ? escapeHtml(dept) : "N/A" %>"
                                                    data-subject="<%= subject != null ? escapeHtml(subject) : "N/A" %>"
                                                    data-qual="<%= qual != null ? escapeHtml(qual) : "Not specified" %>"
                                                    data-exp="<%= exp != null ? escapeHtml(exp) : "Not specified" %>"
                                                    data-desc="<%= desc != null ? escapeHtml(desc) : "N/A" %>"
                                                    data-resp="<%= resp != null ? escapeHtml(resp) : "N/A" %>"
                                                    data-skills="<%= skills != null ? escapeHtml(skills) : "N/A" %>"
                                                    data-contact="<%= escapeHtml(contactInfo) %>"
                                                    onclick="openDetailsModal(this)">
                                                View Details
                                            </button>
                                            <% if (link != null && !link.trim().isEmpty()) { %>
                                                <a href="<%= escapeHtml(link) %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Apply Now</a>
                                            <% } else if (email != null && !email.trim().isEmpty()) { %>
                                                <a href="mailto:<%= escapeHtml(email) %>?subject=Application for <%= escapeHtml(title) %>" class="btn btn-primary">Apply Now</a>
                                            <% } %>
                                        </div>
                                    </div>
                                <%  } %>
                            </div>
                        </div>
        <%
                    }

                    // Render Non-Teaching Positions Section
                    if (!nonTeachingList.isEmpty() && (!hasFilter || "Non-Teaching".equalsIgnoreCase(filterType))) {
        %>
                        <div class="category-section">
                            <h3 class="category-title">Non-Teaching Roles</h3>
                            <div class="grid">
                                <%
                                    for (java.util.Map<String, Object> row : nonTeachingList) {
                                        int id = (Integer) row.get("id");
                                        String title = (String) row.get("title");
                                        String type = (String) row.get("type");
                                        String dept = (String) row.get("dept");
                                        String subject = (String) row.get("subject");
                                        String empType = (String) row.get("empType");
                                        String location = (String) row.get("location");
                                        String salary = (String) row.get("salary");
                                        int vacancies = (Integer) row.get("vacancies");
                                        java.sql.Date lastDate = (java.sql.Date) row.get("lastDate");
                                        String qual = (String) row.get("qual");
                                        String exp = (String) row.get("exp");
                                        String desc = (String) row.get("desc");
                                        String resp = (String) row.get("resp");
                                        String skills = (String) row.get("skills");
                                        String email = (String) row.get("email");
                                        String link = (String) row.get("link");
                                        String contactPerson = (String) row.get("contactPerson");
                                        String contactPhone = (String) row.get("contactPhone");

                                        String contactInfo = (contactPerson != null ? contactPerson : "HR Department") + 
                                                             (contactPhone != null && !contactPhone.trim().isEmpty() ? " (" + contactPhone + ")" : "");
                                %>
                                    <div class="card">
                                        <div>
                                            <div class="card-header-meta">
                                                <span class="badge"><%= escapeHtml(type) %></span>
                                            </div>
                                            <h3 class="card-title"><%= escapeHtml(title) %></h3>
                                            <div class="card-meta">
                                                <strong>Department:</strong> <%= (dept != null && !dept.trim().isEmpty()) ? escapeHtml(dept) : "General" %>
                                                <% if (subject != null && !subject.trim().isEmpty()) { %>
                                                    <br><strong>Subject:</strong> <%= escapeHtml(subject) %>
                                                <% } %>
                                            </div>

                                            <div class="info-details">
                                                <div class="info-row"><strong>Employment:</strong> <span><%= empType != null ? escapeHtml(empType) : "N/A" %></span></div>
                                                <div class="info-row"><strong>Location:</strong> <span><%= location != null ? escapeHtml(location) : "N/A" %></span></div>
                                                <div class="info-row"><strong>Vacancies:</strong> <span><%= vacancies %></span></div>
                                                <% if (salary != null && !salary.trim().isEmpty()) { %>
                                                    <div class="info-row"><strong>Salary:</strong> <span><%= escapeHtml(salary) %></span></div>
                                                <% } %>
                                                <% if (lastDate != null) { %>
                                                    <div class="info-row"><strong>Last Date:</strong> <span><%= lastDate.toString() %></span></div>
                                                <% } %>
                                            </div>
                                        </div>

                                        <div class="card-actions">
                                            <button type="button" class="btn btn-secondary"
                                                    data-title="<%= escapeHtml(title) %>"
                                                    data-type="<%= escapeHtml(type) %>"
                                                    data-dept="<%= dept != null ? escapeHtml(dept) : "N/A" %>"
                                                    data-subject="<%= subject != null ? escapeHtml(subject) : "N/A" %>"
                                                    data-qual="<%= qual != null ? escapeHtml(qual) : "Not specified" %>"
                                                    data-exp="<%= exp != null ? escapeHtml(exp) : "Not specified" %>"
                                                    data-desc="<%= desc != null ? escapeHtml(desc) : "N/A" %>"
                                                    data-resp="<%= resp != null ? escapeHtml(resp) : "N/A" %>"
                                                    data-skills="<%= skills != null ? escapeHtml(skills) : "N/A" %>"
                                                    data-contact="<%= escapeHtml(contactInfo) %>"
                                                    onclick="openDetailsModal(this)">
                                                View Details
                                            </button>
                                            <% if (link != null && !link.trim().isEmpty()) { %>
                                                <a href="<%= escapeHtml(link) %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Apply Now</a>
                                            <% } else if (email != null && !email.trim().isEmpty()) { %>
                                                <a href="mailto:<%= escapeHtml(email) %>?subject=Application for <%= escapeHtml(title) %>" class="btn btn-primary">Apply Now</a>
                                            <% } %>
                                        </div>
                                    </div>
                                <%  } %>
                            </div>
                        </div>
        <%
                    }
                } else {
        %>
                    <div class="empty-state">
                        <h3>No Vacancies Found</h3>
                        <p>We couldn't find any job openings matching your criteria. Please check back later or reset your query.</p>
                    </div>
        <%
                }
            } catch (Exception e) {
        %>
            <div class="empty-state" style="border-color: var(--primary-accent);">
                <h3 style="color: var(--primary-accent);">Unable to Load Vacancies</h3>
                <p>An unexpected error occurred while fetching listings. Please try again later.</p>
            </div>
        <%
            }
        %>
    </div>

    <!-- Job Details Modal -->
    <div id="srs-vacancy-modal" class="modal" role="dialog" aria-modal="true">
        <div class="modal-content">
            <button type="button" class="close-btn" onclick="closeVacancyModal()" aria-label="Close modal">&times;</button>
            <span class="badge" id="m-type"></span>
            <h2 id="m-title" style="margin-top: 0.5rem; color: var(--primary-dark); font-size: 1.35rem;"></h2>
            
            <div class="modal-section">
                <h4>Department & Subject</h4>
                <p><span id="m-dept"></span> (<span id="m-subject"></span>)</p>
            </div>

            <div class="modal-section">
                <h4>Qualifications Required</h4>
                <p id="m-qual"></p>
            </div>

            <div class="modal-section">
                <h4>Experience Required</h4>
                <p id="m-exp"></p>
            </div>

            <div class="modal-section">
                <h4>Job Description</h4>
                <p id="m-desc"></p>
            </div>

            <div class="modal-section">
                <h4>Responsibilities</h4>
                <p id="m-resp"></p>
            </div>

            <div class="modal-section">
                <h4>Key Skills Required</h4>
                <p id="m-skills"></p>
            </div>

            <div class="modal-section">
                <h4>Contact Details</h4>
                <p id="m-contact"></p>
            </div>
        </div>
    </div>
</div>

<script>
    function openDetailsModal(btn) {
        document.getElementById('m-title').textContent = btn.getAttribute('data-title');
        document.getElementById('m-type').textContent = btn.getAttribute('data-type');
        document.getElementById('m-dept').textContent = btn.getAttribute('data-dept');
        document.getElementById('m-subject').textContent = btn.getAttribute('data-subject');
        document.getElementById('m-qual').textContent = btn.getAttribute('data-qual');
        document.getElementById('m-exp').textContent = btn.getAttribute('data-exp');
        document.getElementById('m-desc').textContent = btn.getAttribute('data-desc');
        document.getElementById('m-resp').textContent = btn.getAttribute('data-resp');
        document.getElementById('m-skills').textContent = btn.getAttribute('data-skills');
        document.getElementById('m-contact').textContent = btn.getAttribute('data-contact');

        document.getElementById('srs-vacancy-modal').style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeVacancyModal() {
        document.getElementById('srs-vacancy-modal').style.display = 'none';
        document.body.style.overflow = '';
    }

    window.addEventListener('click', function(event) {
        const modal = document.getElementById('srs-vacancy-modal');
        if (event.target === modal) {
            closeVacancyModal();
        }
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeVacancyModal();
        }
    });
</script>