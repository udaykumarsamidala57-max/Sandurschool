<%-- DESC SECTION --%>

<section class="desc-section">

    <div class="desc-container">

        <%-- Main Title --%>
        <c:if test="${not empty sec.title}">
            <h1 class="desc-title">
                ${sec.title}
            </h1>
        </c:if>


        <%-- Heading 1 --%>
        <c:if test="${not empty sec.heading1}">
            <h2 class="desc-heading1">
                ${sec.heading1}
            </h2>
        </c:if>


        <%-- Content --%>
        <c:if test="${not empty sec.content}">
            <div class="desc-content">
                ${sec.content}
            </div>
        </c:if>


        <%-- Heading 2 --%>
        <c:if test="${not empty sec.heading2}">
            <h3 class="desc-heading2">
                ${sec.heading2}
            </h3>
        </c:if>


        <%-- Images --%>
        <c:if test="${not empty sec.images}">

            <div class="desc-images">

                <c:forEach var="img" items="${sec.images}">

                    <div class="desc-image-wrapper">

                        <img
                            src="${pageContext.request.contextPath}/section-image?id=${img.id}"
                            alt="${img.altText}"
                            class="desc-image"
                        />

                    </div>

                </c:forEach>

            </div>

        </c:if>

    </div>

</section>